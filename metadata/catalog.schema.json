{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline",
    "panel_keys",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "baseline": {
      "const": {
        "start": "2025-04-01",
        "end": "2026-03-31",
        "timezone": "Asia/Tokyo",
        "periods_per_day": 48,
        "period_minutes": 30
      }
    },
    "panel_keys": {
      "const": {
        "market": [
          "delivery_date",
          "period",
          "area"
        ],
        "asset": [
          "delivery_date",
          "period",
          "plant_key",
          "unit_key"
        ],
        "firm": [
          "delivery_date",
          "period",
          "area",
          "firm_canonical"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "name",
          "reference_url",
          "reference_status",
          "grain",
          "primary_key_candidate",
          "key_status",
          "information_timing",
          "intended_period",
          "coverage_status",
          "usage",
          "variables",
          "todos"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reference_url": {
            "type": "string",
            "format": "uri"
          },
          "reference_status": {
            "enum": [
              "entrypoint_only",
              "file_verified"
            ]
          },
          "grain": {
            "type": "string",
            "minLength": 1
          },
          "primary_key_candidate": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "key_status": {
            "enum": [
              "candidate_unverified",
              "verified"
            ]
          },
          "information_timing": {
            "enum": [
              "ex_ante",
              "ex_ante_candidate",
              "ex_post",
              "mixed",
              "not_applicable"
            ]
          },
          "intended_period": {
            "const": {
              "start": "2025-04-01",
              "end": "2026-03-31"
            }
          },
          "coverage_status": {
            "type": "string",
            "minLength": 1
          },
          "usage": {
            "enum": [
              "baseline_input",
              "validation_only"
            ]
          },
          "variables": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "todos": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acquisition": {
            "type": "object",
            "required": [
              "method",
              "manifest_path",
              "bulk_status",
              "sample_variants",
              "format_notes",
              "known_limitations"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "manifest_path": {
                "const": "metadata/acquisition_manifest.jsonl"
              },
              "bulk_status": {
                "enum": [
                  "downloaded_fy2025",
                  "snapshot_only",
                  "blocked"
                ]
              },
              "sample_variants": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "format_notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "known_limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
